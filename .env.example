# Required. Long random string (16+ chars). Protects the config UI and API.
# `npm run dev` fills this in automatically on first run.
ADMIN_TOKEN=
# Optional
PORT=8787
HOST=127.0.0.1
DB_PATH=./data/app.db
# Seconds-level polling gets IPs blocked by YouTube; 30s is the default and the minimum (maximum 24h).
POLL_INTERVAL_MS=30000
# Optional. YouTube Data API v3 key. Used only as a fallback when the RSS feed fails.
# Quota is 10,000 units/day; the API is paused for 1 hour when it runs out.
YOUTUBE_API_KEY=
