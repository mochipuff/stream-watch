# Optional
PORT=8787
# Loopback only. There is no login, so the server refuses to start on any other address.
HOST=127.0.0.1
DB_PATH=./data/app.db
# Seconds-level polling gets IPs blocked by YouTube; 30s is the default and the minimum (maximum 24h).
POLL_INTERVAL_MS=30000
# Optional. YouTube Data API v3 key. Last-resort source: only used when both RSS and page scraping fail.
# Quota is 10,000 units/day; a check costs about 3 units. The API is paused for 1 hour when the quota runs out.
YOUTUBE_API_KEY=
